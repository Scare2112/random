	local module = {}
	local cooldowns = {}
	local commands = require(script.commands)(shared)
	local atliasmap = {} do
		for name, cmd in commands do
			atliasmap[name] = cmd

			if cmd.aliases then
				for _, alias in cmd.aliases do
					atliasmap[alias] = cmd
				end
			end
		end
	end

	function module.setup(plr: Player)
		local cmdsuccess = Instance.new("BindableEvent")

		local signal = plr.Chatted:Connect(function(msg)
			if msg:sub(1, #prefix):lower() ~= prefix:lower() then
				return
			end
			msg = msg:sub(#prefix + 1)
			
			local split = msg:split(" ")
			local command = split[1]
			table.remove(split, 1)

			local cmd = atliasmap[command]
			if not cmd then
				return cmdsuccess:Fire(false, "Command not found")
			end
			
			local cd = cmd.cooldown
			if typeof(cd) == "number" and cd > 0 then
				local now = os.clock()
				local last = cooldowns[cmd]

				if last and now - last < cd then
					return cmdsuccess:Fire(false, "Command on cooldown, please wait "..tostring(cd - (now - last)):sub(1,4).." more seconds.")
				end

				cooldowns[cmd] = now
			end
			
			local done, result

			local ok, success, output, time = pcall(function()
				return cmd.run(plr, unpack(split))
			end)

			if not ok then
				cmdsuccess:Fire(false, success)
				return
			end

			if typeof(success) ~= "boolean" then
				success, output, time = true, success, output
			end

			if typeof(output) ~= "string" then
				output = nil
			end

			if typeof(time) ~= "number" then
				time = nil
			end
			
			cmdsuccess:Fire(success, output, time)
		end)

		return cmdsuccess, signal
	end

	function module.runcmd(cmdname)
		local cmd = commands[cmdname]
		if not cmd then
			return false, "Command not found"
		end

		return cmd.func()
	end

	return module
