					<ProtectedString name="Source"><![CDATA[local module, commands, rawcmds = {}, {}, {}

local settings = require(script.Parent["settings"])

local PREFIX = "g/"
local ranks = {
	[0] = "user",
	[1] = "group member",
	[2] = "mod",
	[3] = "admin",
	[4] = "dev",
	[255] = "creator",
}


for _, v in script:GetChildren() do
	local result = require(v)
	table.insert(rawcmds, {v.Name, result})
	for _, cmdName in string.split(v.Name, "|") do
		commands[string.lower(cmdName)] = result
	end
end


local function getRank(plr: Player)
	local rank = 0
	
	if not settings.groupid or not plr:IsInGroup(settings.groupid) then
		return rank, ranks[rank]
	end
	
	for position, rankName in ranks do
		if plr:GetRankInGroup(settings.groupid) >= position then
			rank = position
		end
	end
	
	return rank, ranks[rank]
end

function module.setupplr(plr: Player)
	local oncmd = Instance.new("BindableEvent")
	
	local chatted = plr.Chatted:Connect(function(msg)
		task.defer(function()

			if msg:sub(1, #PREFIX):lower() ~= PREFIX:lower() then
				return
			end

			local splitMsg = string.split(msg, " ")
			local cmdName = string.lower(splitMsg[1]):sub(#PREFIX + 1)
			local args = {unpack(splitMsg, 2)}

			local cmd = commands[cmdName]

			if not cmd then
				return oncmd:Fire(false, "Unknown command")
			end

			local success, result = pcall(function()
				local _, playerRank = getRank(plr)

				if cmd.rank_required and playerRank ~= cmd.rank_required then
					return oncmd:Fire(false, "Insufficient permissions")
				end
				if type(cmd) == "function" then
					oncmd:Fire(cmd(plr, unpack(args)))
				elseif type(cmd) == "table" and cmd.func then
					oncmd:Fire(cmd.func(plr, unpack(args))) 
				end
			end)

			if not success then
				oncmd:Fire(false, `Error running command {cmdName}: {result}`)
			end
		end)
	end)
	
	return oncmd.Event, chatted
end

function module.runcmd(cmdname)
	local cmd = commands[cmdname]
	if not cmd then
		return false, "Command not found"
	end
	
	if type(cmd) == "function" then
		return cmd()
	elseif type(cmd) == "table" and cmd.func then
		return cmd.func()
	end
end

function module.getcmds()
	return rawcmds
end

return module]]></ProtectedString>
