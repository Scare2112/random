	local content_h = title_h + (title_h > 0 and cfg.spacing or 0) + body_h

	local progress_h = 0
	if cfg.show_progress_bar and duration > 0 then
		progress_h = cfg.progress_bar_height + 6
	end

	local target_h = content_h + (cfg.padding * 2) + progress_h
	if target_h > cfg.max_height then target_h = cfg.max_height end

	frame.Size = UDim2.new(0, cfg.width, 0, target_h)

	content.Position = UDim2.new(0, cfg.padding, 0, cfg.padding)
	content.Size = UDim2.new(1, -(cfg.padding*2), 1, -(cfg.padding*2))

	title_label.Text = title_text or "if your seeing this i messed something up"
	title_label.Size = UDim2.new(1, 0, 0, title_h)

	body_label.Text = body_text or "if your seeing this i messed something up"

	local index = #active + 1
	local start_pos, target_pos = compute_positions(cfg, cfg.side, index, target_h)

