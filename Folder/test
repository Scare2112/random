									<ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local serverModule = {}
serverModule.__index = serverModule

local clientModule = {}
clientModule.__index = clientModule

export type ServerConfig = {
	RemoteType: "RemoteEvent" | "RemoteFunction" | "UnreliableRemoteEvent",
	Name: string,
	Parent: Instance,
	Key: string?,
	Func: (Player?, ...any) -> (any?)
}

export type ClientConfig = {
	RemoteType: "RemoteEvent" | "RemoteFunction" | "UnreliableRemoteEvent",
	Name: string,
	Parent: Instance,
	ExpectedKey: string?,
	Func: (Player?, ...any) -> (any?)?,
	OnEvent: ((...any) -> ())?,
	OnInvoke: ((...any) -> any?)?
}

export type RemoteHandler = {
	Config: ServerConfig,
	Remote: RemoteEvent | RemoteFunction | UnreliableRemoteEvent?,
	Signal: RBXScriptConnection,

	FireClient: (self: RemoteHandler, player: Player, ...any) -> (),
	FireAllClients: (self: RemoteHandler, ...any) -> (),
	Destroy: (self: RemoteHandler) -> ()
}

export type ClientRemoteHandler = {
	Config: ClientConfig,
	Remote: RemoteEvent | RemoteFunction | UnreliableRemoteEvent?,
	Connection: RBXScriptConnection?,

	FireServer: (self: ClientRemoteHandler, ...any) -> (),
	InvokeServer: (self: ClientRemoteHandler, ...any) -> (any?),
	ValidateRemote: (self: ClientRemoteHandler) -> boolean,
	Destroy: (self: ClientRemoteHandler) -> ()
}

local defaultsconfig = {
	RemoteType = "RemoteEvent",
	Parent = game:GetService("ReplicatedStorage"),
	Name = "Remote"
}

-- SERVER
function serverModule.new(Config: ServerConfig?)
	local self = setmetatable({}, serverModule)
	self.Config = Config or {}

	for i, v in defaultsconfig do
		if self.Config[i] == nil then
			self.Config[i] = v
		end
	end

	self.Remote = nil
	self.Signal = RunService.Heartbeat:Connect(function()
		xpcall(function()
			local remote = self.Remote
			local config = self.Config

			if not remote or remote.Parent ~= config.Parent or remote.Name ~= config.Name then
				if remote then
					pcall(function() remote:Destroy() end)
				end

				remote = Instance.new(config.RemoteType)
				remote.Name = config.Name

				if config.RemoteType == "RemoteFunction" then
					remote.OnServerInvoke = function(player, ...)
						local args = {...}
						if config.Key then
							if args[1] == config.Key then
								table.remove(args, 1)
								return config.Func(player, unpack(args))
							else
								return nil, "Key is invalid"
							end
						else
							return config.Func(player, ...)
						end
					end
				else
					remote.OnServerEvent:Connect(function(player, ...)
						local args = {...}
						if config.Key then
							if args[1] == config.Key then
								table.remove(args, 1)
								config.Func(player, unpack(args))
							end
						else
							config.Func(player, ...)
						end
					end)
				end

				remote.Parent = config.Parent
				self.Remote = remote
			end
		end, function(err)
			warn("[Remote Handler]: " .. tostring(err))
			pcall(function()
				if self.Remote then
					self.Remote:Destroy()
				end
			end)
			self.Remote = nil
		end)
	end)

	return self
end

function serverModule:FireClient(player, ...)
	if not self.Remote or not self.Remote:IsDescendantOf(game) then return end
	local args = {...}
	if self.Config.Key then
		table.insert(args, 1, self.Config.Key)
	end
	if self.Remote:IsA("RemoteEvent") or self.Remote:IsA("UnreliableRemoteEvent") then
		self.Remote:FireClient(player, unpack(args))
	elseif self.Remote:IsA("RemoteFunction") then
		warn("[Remote Handler]: Cannot use FireClient on RemoteFunction")
	end
end

function serverModule:FireAllClients(...)
	if not self.Remote or not self.Remote:IsDescendantOf(game) then return end
	local args = {...}
	if self.Config.Key then
		table.insert(args, 1, self.Config.Key)
	end
	if self.Remote:IsA("RemoteEvent") or self.Remote:IsA("UnreliableRemoteEvent") then
		self.Remote:FireAllClients(unpack(args))
	elseif self.Remote:IsA("RemoteFunction") then
		warn("[Remote Handler]: Cannot use FireAllClients on RemoteFunction")
	end
end

function serverModule:InvokeClient(player, ...)
	if not self.Remote or not self.Remote:IsDescendantOf(game) then return nil end
	local args = {...}
	if self.Config.Key then
		table.insert(args, 1, self.Config.Key)
	end
	if self.Remote:IsA("RemoteFunction") then
		return self.Remote:InvokeClient(player, unpack(args))
	else
		warn("[Remote Handler]: InvokeClient can only be used with RemoteFunction")
		return nil
	end
end

function serverModule:Destroy()
	if self.Signal then
		self.Signal:Disconnect()
	end
	if self.Remote then
		self.Remote:Destroy()
	end
end

-- CLIENT
function clientModule.new(Config: ClientConfig)
	local self = setmetatable({}, clientModule)
	self.Config = Config
	self.Remote = nil
	self.Connection = nil

	self.Signal = RunService.Heartbeat:Connect(function()
		if not self:ValidateRemote() then
			local parent = self.Config.Parent
			local remoteName = self.Config.Name
			local remoteType = self.Config.RemoteType

			if not parent:IsDescendantOf(game) then return end

			local remote = parent:FindFirstChild(remoteName)
			if not remote then return end
			if not remote:IsA(remoteType) then return end

			self.Remote = remote

			local handlerEvent = self.Config.Func or self.Config.OnEvent
			local handlerInvoke = self.Config.Func or self.Config.OnInvoke

			if self.Remote and handlerEvent and not self.Remote:IsA("RemoteFunction") then
				if self.Connection then
					self.Connection:Disconnect()
					self.Connection = nil
				end

				self.Connection = self.Remote.OnClientEvent:Connect(function(...)
					local args = {...}
					if self.Config.ExpectedKey then
						if args[1] == self.Config.ExpectedKey then
							table.remove(args, 1)
							handlerEvent(Players.LocalPlayer, unpack(args))
						end
					else
						handlerEvent(Players.LocalPlayer, ...)
					end
				end)
			end

			if self.Remote and self.Remote:IsA("RemoteFunction") and handlerInvoke then
				self.Remote.OnClientInvoke = function(...)
					local args = {...}
					if self.Config.ExpectedKey then
						if args[1] == self.Config.ExpectedKey then
							table.remove(args, 1)
							return handlerInvoke(Players.LocalPlayer, unpack(args))
						else
							error("Invalid key")
						end
					else
						return handlerInvoke(Players.LocalPlayer, ...)
					end
				end
			end
		end
	end)

	return self
end


function clientModule:ValidateRemote()
	if not self.Remote or self.Remote.Parent ~= self.Config.Parent or self.Remote.Name ~= self.Config.Name then
		return false
	end
	return true
end


function clientModule:FireServer(...)
	if not self:ValidateRemote() then return end
	local args = {...}
	if self.Config.ExpectedKey then
		table.insert(args, 1, self.Config.ExpectedKey)
	end
	if self.Remote:IsA("RemoteEvent") or self.Remote:IsA("UnreliableRemoteEvent") then
		self.Remote:FireServer(unpack(args))
	elseif self.Remote:IsA("RemoteFunction") then
		warn("[Client Remote Handler]: Cannot use FireServer on RemoteFunction")
	end
end

function clientModule:InvokeServer(...)
	if not self:ValidateRemote() then return nil end
	local args = {...}
	if self.Config.ExpectedKey then
		table.insert(args, 1, self.Config.ExpectedKey)
	end
	if self.Remote:IsA("RemoteFunction") then
		return self.Remote:InvokeServer(unpack(args))
	else
		warn("[Client Remote Handler]: InvokeServer can only be used with RemoteFunction")
		return nil
	end
end

function clientModule:Destroy()
	if self.Signal then
		self.Signal:Disconnect()
	end
	if self.Connection then
		self.Connection:Disconnect()
	end
	self.Remote = nil
end

return {
	server = serverModule,
	client = clientModule
}
]]></ProtectedString>
