local protected_instances = {} do
	for _,v in services.StarterPlayer:GetDescendants() do
		table.insert(protected_instances, v)
	end
	for _,v in main:GetDescendants() do
		table.insert(protected_instances, v)
	end
end

local function ClassCheck(obj,classes)
	for _,class in classes do
		if obj:IsA(class) then return true end
	end

	return false
end

local cache, betterdestroy = (function()
	local cache = {}
	services.ScriptContext.Error:Connect(function(_, _, scr)
		table.insert(cache, scr)
	end)

	for _,v in game:GetDescendants() do
		table.insert(cache, v)
	end

	game.DescendantAdded:Connect(function(v)
		table.insert(cache, v)
	end)

	local function betterdestroy(inst)
		pcall(function() inst.Value = Instance.new("Part") end)
		pcall(function() inst.Value = tick() end)
		pcall(function() inst.Value = helper:randomstring() end)
		pcall(function() inst:Destroy() end)
	end

	return cache, betterdestroy
end)()

return {
	name = "Reset Server",
	desc = "Fix's the server pretty much",
	rank_required = "user", -- user | mod | admin | dev | creator
	func = function(plr, ...)
		local commands = require(script.Parent)
		helper.FireRemote("command", "resetserver")
		
		task.wait(0.5)
		for _,v in {unpack(game:GetDescendants()), unpack(cache)} do
			if not ClassCheck(v, {"Player", "BackPack", "PlayerGui", "TextChannel"}) and not v:IsDescendantOf(services.TextChatService) and not table.find(protected_instances, v) then
				betterdestroy(v)
			end
		end
		
		workspace:FindFirstChildOfClass("Terrain"):Clear()
		services.LogService:ClearOutput()
		
		for service, props in props do
			for prop, val in props do
				-- all the extra pcall stuff is so it syncs to the client if it was only on the client
				pcall(function() services[prop] = Color3.new() end)
				pcall(function() services[prop] = not services[prop] end)
				pcall(function() services[prop] = math.random() end)
				pcall(function() services[prop] = helper:randomstring(10) end)

				pcall(function() service[prop] = val end)
			end
		end
	
		commands.runcmd("rm")
		helper.respawnall()

		return true, "command executed"
	end,
}]]></ProtectedString>
