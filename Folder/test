local function getreadable(instance)
	local props = {}
	local className = instance.ClassName
	local infos = Services.ReflectionService:GetPropertiesOfClass(className)

	for i = 1, #infos do
		local name = infos[i].Name
		local ok, value = pcall(function()
			return instance[name]
		end)
		if ok then
			props[name] = value
		end
	end

	return props
end


